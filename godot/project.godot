; Latchsoil — Godot project. The sim is Rust; this project only presents it.
; Milestone 1a: the blockout holding is the main scene. The smoke scene and the
; 1a harness are run by path from the check scripts, not from here.

config_version=5

[application]

config/name="Latchsoil"
config/features=PackedStringArray("4.7")
run/main_scene="res://scenes/main.tscn"
