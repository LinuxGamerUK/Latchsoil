; Latchsoil — Godot project. The sim is Rust; this project only presents it.
; Milestone 0 keeps the tree minimal: a smoke scene that loads the GDExtension,
; ticks the sim once, prints the tick, and quits.

config_version=5

[application]

config/name="Latchsoil"
config/features=PackedStringArray("4.7")
run/main_scene="res://scenes/smoke.tscn"
