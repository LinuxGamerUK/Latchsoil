; Latchsoil GDExtension. Built by scripts/build-extension.sh, which links the
; cdylib into godot/bin/ so the library path stays inside res:// and survives export.
;
; entry_symbol is the default ident the `#[gdextension]` macro emits.
; The engine API is fixed by the `api-4-7` feature on the `godot` crate, which
; compiles against prebuilt 4.7 bindings — no editor binary is needed to build.

[configuration]

entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.2"
reloadable = true

[libraries]

linux.debug.x86_64 = "res://bin/liblatchsoil_godot.so"
linux.release.x86_64 = "res://bin/liblatchsoil_godot.so"
